          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Resolve new_exercise_id" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def fallbackId = vars.get(&apos;EXERCISE_ID&apos;) ?: &apos;1&apos;
def response = prev.getResponseDataAsString()

try {
    def json = new JsonSlurper().parseText(response)
    def data = (json?.data instanceof List) ? json.data : []
    def maxId = data.collect { it?.id }
        .findAll { it != null }
        .collect { (it as Number).longValue() }
        .max()

    vars.put(&apos;new_exercise_id&apos;, maxId != null ? String.valueOf(maxId) : fallbackId)
} catch (Exception ignored) {
    vars.put(&apos;new_exercise_id&apos;, fallbackId)
}</stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
